{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "gh api /repos/*": "allow",
      "gh api repos/*": "allow",
      "gh api /repos/*/issues/*/comments*": "deny",
      "gh api /repos/*/pulls/*/comments*": "deny",
      "gh api /repos/*/pulls/*/reviews*": "deny",
      "gh api repos/*/issues/*/comments*": "deny",
      "gh api repos/*/pulls/*/comments*": "deny",
      "gh api repos/*/pulls/*/reviews*": "deny",
      "gh api repos/*/actions/jobs/*/logs": "allow",
      "gh gist create": "allow",
      "gh gist create *": "allow",
      "gh issue view": "allow",
      "gh issue view *": "allow",
      "gh pr checks": "allow",
      "gh pr checks *": "allow",
      "gh pr diff": "allow",
      "gh pr diff *": "allow",
      "gh pr view": "allow",
      "gh pr view *": "allow",
      "gh repo view": "allow",
      "gh repo view *": "allow",
      "gh run view": "allow",
      "gh run view *": "allow",
      "git branch --show-current": "allow",
      "git remote get-url origin": "allow",
      "git add": "ask",
      "git add *": "ask",
      "git commit": "ask",
      "git commit *": "ask",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "just benchmark": "allow",
      "just benchmark *": "allow",
      "just cover": "allow",
      "just cover *": "allow",
      "just docs": "allow",
      "just docs *": "allow",
      "just install": "allow",
      "just install *": "allow",
      "just pre-commit": "allow",
      "just pre-commit *": "allow",
      "just test": "allow",
      "just test *": "allow",
      "just typing": "allow",
      "just typing *": "allow",
      "gh pr comment": "deny",
      "gh pr comment *": "deny",
      "gh pr merge": "deny",
      "gh pr merge *": "deny",
      "gh pr create": "ask",
      "gh pr create *": "ask",
      "git push": "ask",
      "git push *": "ask"
    }
  }
}
