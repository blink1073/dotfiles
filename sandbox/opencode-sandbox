#!/usr/bin/env bash
# opencode-sandbox — open an opencode session in a per-project podman sandbox.
#
# It creates the sandbox container only if one for the current directory isn't
# already running, then drops you into opencode inside it. Tear down with
# `podbox rm`. See `podbox` for all options (PODBOX_NAME, PODBOX_IMAGE,
# PODBOX_MODEL, PODBOX_ENTRY, GH_TOKEN_SANDBOX).

set -euo pipefail

exec podbox up "$@"
